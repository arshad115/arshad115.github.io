---
import { formatDate, tagSlug } from '../lib/site';
import type { SiteEntry } from '../lib/content';

interface Props {
  entry: SiteEntry;
  maxTags?: number;
}

const { entry, maxTags } = Astro.props;
const tags = entry.tags ?? [];
const visibleTags = typeof maxTags === 'number' ? tags.slice(0, maxTags) : tags;
const hiddenTagCount = tags.length - visibleTags.length;
---

<p class="meta" data-pagefind-ignore>
  {entry.date && <time datetime={entry.date.toISOString()}>{formatDate(entry.date)}</time>}
  {entry.updated && (
    <span>
      Updated <time datetime={entry.updated.toISOString()}>{formatDate(entry.updated)}</time>
    </span>
  )}
  {entry.kind === 'post' && <span>{entry.minutes} min read</span>}
  {entry.category && (
    <a href={entry.categoryPath || `/categories/#${entry.category}`}>{entry.categoryLabel || entry.category}</a>
  )}
  {visibleTags.map((tag) => (
      <a href={`/tags/#${tagSlug(tag)}`}>{tag}</a>
    ))}
  {hiddenTagCount > 0 && <span aria-label={`${hiddenTagCount} more topics`}>+{hiddenTagCount}</span>}
</p>
