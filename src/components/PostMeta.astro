---
import { formatDate } from '../lib/site';
import type { SiteEntry } from '../lib/content';

interface Props {
  entry: SiteEntry;
}

const { entry } = Astro.props;
---

<p class="meta" data-pagefind-ignore>
  {entry.date && <time datetime={entry.date.toISOString()}>{formatDate(entry.date)}</time>}
  {entry.kind === 'post' && <span>{entry.minutes} min read</span>}
  {entry.category && (
    <a href={entry.categoryPath || `/categories/#${entry.category.toLowerCase()}`}>{entry.category}</a>
  )}
  {(entry.tags ?? []).map((tag) => (
      <a href={`/tags/#${tag.toLowerCase().replace(/\s+/g, '-')}`}>{tag}</a>
    ))}
</p>
