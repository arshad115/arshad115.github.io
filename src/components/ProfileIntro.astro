---
import { imageSize } from '../lib/image-size.mjs';
import { SITE } from '../lib/site';

const profileSize = imageSize(SITE.profileImage);
if (!profileSize) throw new Error(`Missing profile image ${SITE.profileImage}`);
interface Props {
  kicker: string;
  title: string;
}
const { kicker, title } = Astro.props;
---
<header class="home-intro">
  <div class="home-copy">
    <p class="kicker">{kicker}</p>
    <h1>{title}</h1>
    <p class="lede"><slot /></p>
    {Astro.slots.has('links') && <p class="home-note"><slot name="links" /></p>}
  </div>
  <figure class="home-photo">
    <picture>
      <source
        srcset="/assets/images/arshad-mehmood-software-engineer-germany.webp"
        type="image/webp"
      />
      <img
        src={SITE.profileImage}
        alt={SITE.profileImageAlt}
        width={profileSize.width}
        height={profileSize.height}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
  </figure>
</header>
