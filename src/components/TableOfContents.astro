---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter(
  (heading) => heading.depth === 2 && !/^table of contents$/i.test(heading.text.trim()),
);
---

{items.length > 2 && (
  <nav class="toc" aria-label="On this page" data-pagefind-ignore>
    <h2>On this page</h2>
    <ol>
      {items.map((heading) => (
        <li style={`margin-left: ${(heading.depth - 2) * 0.9}rem`}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}
