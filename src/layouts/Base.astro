---
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource-variable/source-sans-3/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/400-italic.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../lib/site';
import {
  absoluteUrl,
  buildJsonLd,
  isoDateTime,
  jsonLdScript,
  markdownPath,
} from '../lib/seo.mjs';

interface Props {
  title?: string;
  description?: string;
  permalink?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  kind?: 'post' | 'page' | 'til' | 'portfolio';
  pageType?: string;
  published?: Date;
  modified?: Date;
  tags?: string[];
  section?: string;
  categoryLabel?: string;
  minutes?: number;
  wordCount?: number;
  robots?: string;
  markdown?: boolean | string;
}

const {
  title,
  description = SITE.description,
  permalink = Astro.url.pathname,
  image = SITE.defaultImage,
  imageAlt = SITE.defaultImageAlt,
  type = 'website',
  kind,
  pageType,
  published,
  modified,
  tags = [],
  section,
  categoryLabel,
  minutes,
  wordCount,
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  markdown = false,
} = Astro.props;

const pageTitle = title && title !== SITE.title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = absoluteUrl(permalink);
const ogImage = image.startsWith('http') ? image : absoluteUrl(image);
const markdownHref =
  markdown === true ? absoluteUrl(markdownPath(permalink)) : markdown ? absoluteUrl(String(markdown)) : undefined;
const publishedAt = isoDateTime(published);
const modifiedAt = isoDateTime(modified || published);
const jsonLd = buildJsonLd({
  permalink,
  title: title || SITE.title,
  description,
  image,
  kind,
  pageType,
  published,
  modified,
  tags,
  section,
  categoryLabel,
  minutes,
  wordCount,
});
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="author" href={absoluteUrl('/about/')} />
    <link rel="describedby" href={absoluteUrl('/llms.txt')} type="text/markdown" />
    {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} title="Markdown version" />}
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title || SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    {
      type === 'article' && publishedAt && (
        <meta property="article:published_time" content={publishedAt} />
      )
    }
    {
      type === 'article' && modifiedAt && (
        <meta property="article:modified_time" content={modifiedAt} />
      )
    }
    {type === 'article' && <meta property="article:author" content={SITE.author} />}
    {type === 'article' && categoryLabel && <meta property="article:section" content={categoryLabel} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitterHandle} />
    <meta name="twitter:creator" content={SITE.twitterHandle} />
    <meta name="twitter:title" content={title || SITE.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="theme-color" content="#b8563d" />
    <link rel="icon" href="/assets/images/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg" />
    <link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={absoluteUrl('/feed.xml')} />
    <script type="application/ld+json" is:inline set:html={jsonLdScript(jsonLd)} />
    <slot name="head" />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const theme = stored === 'dark' || stored === 'light' ? stored : 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <SiteHeader />
    <main id="content" class="page wrap">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
