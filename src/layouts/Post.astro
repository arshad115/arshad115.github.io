---
import { render } from 'astro:content';
import Base from './Base.astro';
import PostMeta from '../components/PostMeta.astro';
import TableOfContents from '../components/TableOfContents.astro';
import GiscusComments from '../components/GiscusComments.astro';
import type { SiteEntry } from '../lib/content';
import { imageSize } from '../lib/image-size.mjs';
import { relatedHeading } from '../lib/related.mjs';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/400-italic.css';

interface Props {
  entry: SiteEntry;
  related?: SiteEntry[];
}

const { entry, related = [] } = Astro.props;
const { Content, headings } = await render(entry.collection);
const showToc = entry.showToc && headings.filter((heading) => heading.depth >= 2).length > 2;
const image = entry.header?.image;
const imageAlt = entry.header?.alt || entry.title;
const localImage = image && !/^https?:\/\//i.test(image) ? image : undefined;
const localTeaser = entry.header?.teaser && !/^https?:\/\//i.test(entry.header.teaser) ? entry.header.teaser : undefined;
const socialImage = localImage || localTeaser;
const socialImageAlt = socialImage ? imageAlt : undefined;
const imageDimensions = image ? imageSize(image) : undefined;
const captionId = entry.header?.caption ? 'header-caption' : undefined;
const relatedTitle = relatedHeading(entry, related);
const isAbout = entry.kind === 'page' && entry.permalink === '/about/';
const archiveCutoff = new Date();
archiveCutoff.setUTCFullYear(archiveCutoff.getUTCFullYear() - 5);
const isArchivedPost =
  entry.kind === 'post' &&
  Boolean(entry.date && entry.date < archiveCutoff) &&
  !(entry.updated && entry.updated >= archiveCutoff);
const ogType = entry.kind === 'page' ? 'website' : 'article';
const pageType =
  entry.kind === 'page' && entry.permalink === '/about/'
    ? 'AboutPage'
    : entry.kind === 'page'
      ? 'WebPage'
      : undefined;
---

<Base
  title={entry.title}
  description={entry.excerpt}
  permalink={entry.permalink}
  image={socialImage}
  imageAlt={socialImageAlt}
  type={ogType}
  kind={entry.kind}
  pageType={pageType}
  published={entry.date}
  modified={entry.updated}
  tags={entry.tags}
  section={entry.category}
  categoryLabel={entry.categoryLabel}
  minutes={entry.minutes}
  wordCount={entry.wordCount}
  markdown
>
  {entry.kind === 'post' && <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>}
  <article class:list={['post-page', { 'post-page-wide': entry.kind === 'post', 'about-page': isAbout }]} data-pagefind-body>
    {image && (
      <figure class={entry.kind === 'post' ? 'post-hero' : 'figure-plain reading'} data-pagefind-ignore>
        <img
          src={image}
          alt={imageAlt}
          width={imageDimensions?.width}
          height={imageDimensions?.height}
          decoding="async"
          fetchpriority="high"
          aria-describedby={captionId}
        />
        {entry.header?.caption && (
          <figcaption id={captionId}>
            {entry.header.captionHref ? (
              <a href={entry.header.captionHref}>{entry.header.caption}</a>
            ) : (
              entry.header.caption
            )}
          </figcaption>
        )}
      </figure>
    )}
    <header class="post-heading reading">
      <p class="kicker" data-pagefind-ignore>
        {entry.kind === 'til' && 'Today I Learned'}
        {entry.kind === 'post' && (entry.categoryLabel || 'Article')}
        {entry.kind === 'portfolio' && 'Portfolio'}
        {entry.kind === 'page' && !isAbout && 'Page'}
        {isAbout && 'About me'}
      </p>
      <h1>{entry.title}</h1>
      {entry.kind !== 'page' && <PostMeta entry={entry} maxTags={3} />}
      {isArchivedPost && (
        <aside class="archive-note" data-pagefind-ignore>
          <strong>Archive note</strong>
          <span>This article is more than five years old and may reference outdated software or practices.</span>
        </aside>
      )}
    </header>
    <div class:list={['post-content-grid', { 'has-sidebar': showToc && entry.kind === 'post' }]}>
      {showToc && entry.kind === 'post' && (
        <aside class="post-sidebar" data-pagefind-ignore>
          <TableOfContents headings={headings} />
        </aside>
      )}
      <div class="post-main reading">
        {showToc && entry.kind !== 'post' && <TableOfContents headings={headings} />}
        <div class="prose">
          <Content />
        </div>
        {related.length > 0 && (
          <aside class="related" data-pagefind-ignore>
            <h2>{relatedTitle}</h2>
            <ul>
              {related.map((item) => (
                <li>
                  <a href={item.permalink}>{item.title}</a>
                </li>
              ))}
            </ul>
          </aside>
        )}
        {entry.kind === 'post' && entry.comments && (
          <div data-pagefind-ignore>
            <GiscusComments />
          </div>
        )}
      </div>
    </div>
  </article>
  {entry.kind === 'post' && (
    <script>
      const article = document.querySelector<HTMLElement>('.post-page');
      const progress = document.querySelector<HTMLElement>('[data-reading-progress]');

      const updateProgress = () => {
        if (!article || !progress) return;
        const start = article.offsetTop;
        const distance = Math.max(1, article.offsetHeight - window.innerHeight);
        const value = Math.min(1, Math.max(0, (window.scrollY - start) / distance));
        progress.style.transform = `scaleX(${value})`;
      };

      for (const pre of document.querySelectorAll<HTMLElement>('.prose pre')) {
        const wrapper = document.createElement('div');
        wrapper.className = 'code-block';
        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'copy-code';
        button.textContent = 'Copy';
        button.setAttribute('aria-label', 'Copy code to clipboard');
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(pre.innerText);
            button.textContent = 'Copied';
            window.setTimeout(() => { button.textContent = 'Copy'; }, 1600);
          } catch {
            button.textContent = 'Select code';
          }
        });
        wrapper.appendChild(button);
      }

      for (const heading of document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]')) {
        const anchor = document.createElement('a');
        anchor.className = 'heading-anchor';
        anchor.href = `#${heading.id}`;
        anchor.textContent = '#';
        anchor.setAttribute('aria-label', `Link to ${heading.textContent?.trim() || 'section'}`);
        heading.appendChild(anchor);
      }

      updateProgress();
      window.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress);
    </script>
  )}
</Base>
