---
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { getPosts } from '../lib/content';
import { imageSize } from '../lib/image-size.mjs';
import { SITE } from '../lib/site';

const posts = await getPosts();
const latest = posts.slice(0, 5);
const profileSize = imageSize(SITE.profileImage);
if (!profileSize) throw new Error(`Missing profile image ${SITE.profileImage}`);
---

<Base
  title={SITE.homeTitle}
  description={SITE.description}
  permalink="/"
  type="profile"
  pageType="ProfilePage"
  markdown="/index.md"
>
  <div class="home-intro">
    <div class="home-copy">
      <p class="kicker">Software Engineer at SAP · Germany</p>
      <h1>Hi, I’m Arshad.</h1>
      <p class="lede">
        I build backend services with Go and Kubernetes. Here I write about the tools I make
        and what I learn running my own servers, including <a href="/devops/how-fail2ban-locked-me-out-of-my-own-server-traefik-authentik/">how I locked myself out of one</a>.
      </p>
      <p class="home-note">
        <a href="/posts/">Read the posts <span aria-hidden="true">→</span></a>
        <a href="/today-i-learned/">Today I Learned <span aria-hidden="true">→</span></a>
      </p>
    </div>
    <figure class="home-photo">
      <picture>
        <source
          srcset="/assets/images/arshad-mehmood-software-engineer-germany.webp"
          type="image/webp"
        />
        <img
          src={SITE.profileImage}
          alt={SITE.profileImageAlt}
          width={profileSize.width}
          height={profileSize.height}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    </figure>
  </div>

  <section class="home-latest">
    <div class="section-head">
      <h2>Latest posts</h2>
      <a href="/posts/">All posts</a>
    </div>
    <EntryList entries={latest} headingLevel="h3" showTags={false} />
  </section>
</Base>
