---
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { getPosts } from '../lib/content';
import { imageSize } from '../lib/image-size.mjs';
import { SITE } from '../lib/site';

const posts = await getPosts();
const latest = posts.slice(0, 5);
const profileSize = imageSize(SITE.profileImage);
if (!profileSize) throw new Error(`Missing profile image ${SITE.profileImage}`);
---

<Base
  title={SITE.homeTitle}
  description={SITE.description}
  permalink="/"
  type="profile"
  pageType="ProfilePage"
  markdown="/index.md"
>
  <div class="home-intro">
    <div class="home-copy">
      <p class="kicker">Software Engineer at SAP · Germany</p>
      <h1>A working notebook on cloud-native backends.</h1>
      <p class="lede">
        Arshad Mehmood is a Software Engineer at SAP SE in Germany and founder of Kookydroid. He
        holds an M.Sc. in Business Informatics from the University of Mannheim and specializes in
        cloud-native backend engineering with Go and Kubernetes, DevOps, self-hosted systems, and
        Android development.
      </p>
      <p class="home-note">
        Longer investigations are posts. Short commands and discoveries go in Today I Learned.
      </p>
    </div>
    <figure class="home-photo">
      <picture>
        <source
          srcset="/assets/images/arshad-mehmood-software-engineer-germany.webp"
          type="image/webp"
        />
        <img
          src={SITE.profileImage}
          alt={SITE.profileImageAlt}
          width={profileSize.width}
          height={profileSize.height}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    </figure>
  </div>

  <section class="home-latest">
    <div class="section-head">
      <h2>Latest posts</h2>
      <a href="/posts/">All posts</a>
    </div>
    <EntryList entries={latest} headingLevel="h3" />
  </section>
</Base>
