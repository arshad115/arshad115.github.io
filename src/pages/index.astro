---
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { getPosts } from '../lib/content';
import ProfileIntro from '../components/ProfileIntro.astro';
import { SITE } from '../lib/site';

const posts = await getPosts();
const latest = posts.slice(0, 5);
---

<Base
  title={SITE.homeTitle}
  description={SITE.description}
  permalink="/"
  type="profile"
  pageType="ProfilePage"
  markdown="/index.md"
>
  <ProfileIntro kicker="Software Engineer at SAP · Germany" title="Hi, I’m Arshad.">
    I build backend services with Go and Kubernetes. Here I write about the tools I make
    and what I learn running my own servers.
    <Fragment slot="links">
      <a href="/posts/">Read the posts <span aria-hidden="true">→</span></a>
      <a href="/today-i-learned/">Today I Learned <span aria-hidden="true">→</span></a>
    </Fragment>
  </ProfileIntro>

  <section class="home-latest">
    <h2>Latest posts</h2>
    <EntryList entries={latest} headingLevel="h3" showTags={false} />
    <p class="archive-link"><a href="/posts/">View all posts <span aria-hidden="true">→</span></a></p>
  </section>
</Base>
