---
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { getPosts } from '../lib/content';
import { SITE } from '../lib/site';

const posts = await getPosts();
const latest = posts.slice(0, 5);
---

<Base title={SITE.title} description={SITE.description} permalink="/" markdown="/index.md">
  <div class="home-intro">
    <div class="home-copy">
      <p class="kicker">Software engineer · Mannheim</p>
      <h1>Arshad Mehmood</h1>
      <p class="lede">
        I document practical lessons from building and operating software: DevOps, Android,
        infrastructure, and the problems that only become obvious when systems fail.
      </p>
      <p>
        Technical articles live in Posts. Smaller discoveries and commands go into Today I Learned.
      </p>
      <div class="home-actions">
        <a class="button" href="/posts/">Read the posts</a>
        <a class="home-secondary-link" href="/today-i-learned/">Browse Today I Learned <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <figure class="home-photo">
      <img
        src="/assets/images/bio-photo.jpg"
        alt="Arshad Mehmood sitting by the river in Mannheim"
        width="900"
        height="1200"
      />
    </figure>
  </div>

  <section>
    <div class="section-head">
      <h2>Latest posts</h2>
      <a href="/posts/">All posts</a>
    </div>
    <EntryList entries={latest} headingLevel="h3" />
  </section>
</Base>
