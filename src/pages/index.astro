---
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { getPosts } from '../lib/content';
import { SITE } from '../lib/site';

const posts = await getPosts();
const latest = posts.slice(0, 5);
---

<Base
  title={SITE.homeTitle}
  description={SITE.description}
  permalink="/"
  type="profile"
  pageType="ProfilePage"
  markdown="/index.md"
>
  <div class="home-intro">
    <div class="home-copy">
      <p class="kicker">Software Engineer at SAP · Mannheim, Germany</p>
      <h1>Arshad Mehmood</h1>
      <p class="lede">
        Arshad Mehmood is a Software Engineer at SAP SE in Germany and the founder of Kookydroid.
        He holds an M.Sc. in Business Informatics from the University of Mannheim and specializes
        in cloud-native backend engineering, Go, Kubernetes, DevOps infrastructure, self-hosted
        systems, and Android development.
      </p>
      <p>
        Technical articles live in Posts. Smaller discoveries and commands go into Today I Learned.
      </p>
      <div class="home-actions">
        <a class="button" href="/posts/">Read the posts</a>
        <a class="home-secondary-link" href="/today-i-learned/">Browse Today I Learned <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <figure class="home-photo">
      <img
        src={SITE.profileImage}
        alt={SITE.profileImageAlt}
        width="460"
        height="460"
      />
    </figure>
  </div>

  <section>
    <div class="section-head">
      <h2>Latest posts</h2>
      <a href="/posts/">All posts</a>
    </div>
    <EntryList entries={latest} headingLevel="h3" />
  </section>
</Base>
