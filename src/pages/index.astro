---
import CustomPage from '../components/CustomPage.astro';
import PostMetaRow from '../components/PostMetaRow.astro';
import siteData from '../generated/site-data.json';
---

<CustomPage
  title="Arshad Mehmood"
  description="Software engineer writing about DevOps, Android, software engineering, and continuous learning."
  template="splash"
>
  <div class="home-page">
    <section class="hero-panel">
      <div class="hero-copy">
        <p class="eyebrow">Software engineer in Mannheim</p>
        <h1>Writing about systems, software, and the notes worth keeping.</h1>
        <p class="lede">
          Essays, tutorials, and a living <a href="/today-i-learned/">Today I Learned</a> notebook.
        </p>
        <div class="action-row">
          <a class="action action-primary" href="/posts/">Read posts</a>
          <a class="action" href="/today-i-learned/">Browse TIL</a>
        </div>
      </div>
      <div class="hero-aside">
        <img src="/assets/images/bio-photo.jpg" alt="Arshad Mehmood sitting by the river" />
        <p class="hero-meta">
          <span>{siteData.posts.length} posts</span>
          <span>{siteData.til.length} TIL notes</span>
        </p>
      </div>
    </section>

    <section class="section-block home-posts">
      <div class="section-heading">
        <h2>Latest posts</h2>
        <a class="section-link" href="/posts/">All posts</a>
      </div>
      <div class="stack-list home-post-list">
        {siteData.recentPosts.map((post) => (
          <article class="stack-item">
            <h3><a href={post.url}>{post.title}</a></h3>
            <PostMetaRow
              pubDate={post.pubDate}
              readingTime={post.readingTime}
              category={post.category}
              categorySlug={post.categorySlug}
            />
          </article>
        ))}
      </div>
    </section>
  </div>
</CustomPage>
