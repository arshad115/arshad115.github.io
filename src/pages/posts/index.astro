---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
---

<Base title="All posts" description="Every essay and tutorial, newest first." permalink="/posts/">
  <div class="reading">
    <p class="kicker">Index</p>
    <h1>All posts</h1>
    <p class="lede">Newest first. Category and tag indexes live next door if you want to wander that way.</p>
  </div>
  <EntryList entries={posts} />
</Base>
