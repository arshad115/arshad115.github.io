---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../lib/site';
---

<Base
  title="Contact"
  description="Preferred methods of sending your questions, inquiries, messages, and love letters to me."
  permalink="/contact/"
  pageType="ContactPage"
>
  <article class="reading">
    <p class="kicker">Mail</p>
    <h1>Contact</h1>
    <div class="prose">
      <p>
        Have questions about me, this website, writing code, or making mobile apps? Short messages via{' '}
        <a href={SITE.twitter}>X</a>
        {' '}or{' '}
        <a href="https://www.linkedin.com/in/arshadmehmood115/">LinkedIn</a>
        {' '}are usually the fastest route. You can also lurk{' '}
        <a href="/support/#follow">elsewhere on the web</a>.
      </p>
      <p>For anything else, use the form below.</p>
    </div>
    <form
      class="contact-form"
      id="contact-form"
      accept-charset="UTF-8"
      autocomplete="on"
      method="post"
      action="/api/contact"
    >
      <label>
        Name
        <input id="contact-name" name="name" type="text" autocomplete="name" spellcheck="false" maxlength="100" required placeholder="Your name" />
      </label>
      <label>
        Email address
        <input
          id="contact-email"
          name="email"
          type="email"
          autocomplete="email"
          spellcheck="false"
          maxlength="255"
          required
          placeholder="email@address.com"
        />
      </label>
      <label>
        <span>Website <small>(optional)</small></span>
        <input id="contact-website" name="website" type="url" autocomplete="url" spellcheck="false" maxlength="255" placeholder="https://example.com" />
      </label>
      <label>
        Message
        <textarea id="contact-message" name="message" spellcheck="true" rows="8" maxlength="5000" required></textarea>
      </label>
      <input class="hidden-field" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <div class="contact-actions">
        <button type="submit">Send message</button>
        <p class="contact-status" role="status" aria-live="polite"></p>
      </div>
      <p class="contact-privacy">
        Your details are used only to reply to your message. Read the{' '}
        <a href="/terms/#contact-form">contact-form privacy notice</a>.
      </p>
    </form>
  </article>
  <script>
    const form = document.querySelector<HTMLFormElement>('#contact-form');
    const status = form?.querySelector<HTMLElement>('.contact-status');
    const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity() || !status || !submit) return;

      submit.disabled = true;
      submit.textContent = 'Sending…';
      status.className = 'contact-status';
      status.textContent = 'Sending your message…';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || result.success === false) {
          throw new Error(typeof result.message === 'string' ? result.message : 'Your message could not be sent.');
        }

        form.reset();
        status.classList.add('is-success');
        status.textContent = 'Thanks — your message has been sent.';
      } catch (error) {
        status.classList.add('is-error');
        status.textContent = error instanceof Error
          ? `${error.message} Please try again.`
          : 'Your message could not be sent. Please try again.';
      } finally {
        submit.disabled = false;
        submit.textContent = 'Send message';
      }
    });
  </script>
</Base>
