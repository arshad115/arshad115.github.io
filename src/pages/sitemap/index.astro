---
import Base from '../../layouts/Base.astro';
import { getRenderableEntries, listingRoutes } from '../../lib/content';
import { humanSitemapGroups } from '../../lib/seo.mjs';

const entries = await getRenderableEntries();
const groups = humanSitemapGroups({ listingRoutes, entries });
---

<Base
  title="Sitemap"
  description="A list of pages, posts, and notes on this site."
  permalink="/sitemap/"
  pageType="CollectionPage"
>
  <article class="reading">
    <p class="kicker">Map</p>
    <h1>Sitemap</h1>
    <p>
      A list of pages on the site. Crawlers can use the{' '}
      <a href="/sitemap.xml">XML sitemap</a>
      . Agents can start from{' '}
      <a href="/llms.txt">llms.txt</a>
      {' '}or the{' '}
      <a href="/llms-full.txt">full Markdown catalog</a>.
    </p>
  </article>
  {groups.map((group) => (
    <section class="taxonomy">
      <h2>{group.name}</h2>
      <ul>
        {group.items.map((item: { path: string; title: string }) => (
          <li>
            <a href={item.path}>{item.title}</a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
