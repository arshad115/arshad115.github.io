# Giscus comments (client-visible by design; required for the post discussion widget)
PUBLIC_GISCUS_REPO=arshad115/arshad115.github.io
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=
PUBLIC_GISCUS_MAPPING=pathname
PUBLIC_GISCUS_THEME=preferred_color_scheme
PUBLIC_GISCUS_LIGHT_THEME=light
PUBLIC_GISCUS_DARK_THEME=dark

# Ship posts without comments. Required on master deploy if the Giscus secrets are unset.
# COMMENTS_DISABLED=true
# PUBLIC_COMMENTS_DISABLED=true
